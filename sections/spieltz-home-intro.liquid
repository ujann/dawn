<section class="spieltz-home-intro page-width">
  <div class="spieltz-home-intro__copy">
    <h1>{{ section.settings.heading | escape }}</h1>
    <div class="rte">{{ section.settings.text }}</div>
    {% if section.settings.button_label != blank %}
      <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
    {% endif %}
  </div>
  {% if section.settings.image != blank %}
    <div class="spieltz-home-intro__art">
      {{ section.settings.image | image_url: width: 640 | image_tag: widths: '240, 360, 480, 640', sizes: '(min-width: 750px) 360px, 200px', loading: 'eager', fetchpriority: 'high', alt: '' }}
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Spieltz Einstieg",
  "settings": [
    {"type": "text", "id": "heading", "label": "Überschrift", "default": "Spiele, Spielmaterial und Blanko-Sets für deine Ideen"},
    {"type": "richtext", "id": "text", "label": "Einleitung", "default": "<p>Entdecke Familienspiele, gestalte dein eigenes Spiel oder finde passende Figuren und Würfel.</p>"},
    {"type": "text", "id": "button_label", "label": "Buttontext", "default": "Entdecke unser Sortiment"},
    {"type": "url", "id": "button_link", "label": "Buttonziel"},
    {"type": "image_picker", "id": "image", "label": "Spieltz-Figur (Original)"}
  ],
  "presets": [{"name": "Spieltz Einstieg"}]
}
{% endschema %}
